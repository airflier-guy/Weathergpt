# HOW TO USE: make a copy of this file named exactly  .env  and fill in the lines you want.
# Everything is OPTIONAL. With no keys at all the app still works (basic mode).
# Do NOT put spaces around the = sign and do NOT use quotes.

# Free AI (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Free Telegram bot (create with @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=

# Paid alternative (only if you have one)
# ANTHROPIC_API_KEY=

# PORT=3000

# ---- Optional extras (new) ----
# Lasting Telegram subscriptions on free hosting (free account at upstash.com -> Redis -> REST API):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Lets a free pinger (cron-job.org) wake the server and send morning briefs. Choose any long secret word:
CRON_KEY=
